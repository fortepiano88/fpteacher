<script>
// --- IMPORTANT: Paste your Web App URL below ---
const APPS_SCRIPT_URL = 'YOUR_WEB_APP_URL_HERE';

let currentTeacher = null;
let assignedStudents = [];
let selectedStudent = null;
let selectedStatus = null;
let waMessage = '';

window.addEventListener('DOMContentLoaded', async () => {
  const params = new URLSearchParams(window.location.search);
  const accessKey = params.get('key');

  if (!accessKey) {
    document.getElementById('loading-screen').innerHTML = '<h2>Access Denied</h2><p>No access key provided in URL.</p>';
    return;
  }

  try {
    const res = await fetch(`${APPS_SCRIPT_URL}?key=${encodeURIComponent(accessKey)}`);
    const data = await res.json();

    if (!data.success) {
      document.getElementById('loading-screen').innerHTML = `<h2>Error</h2><p>${data.error}</p>`;
      return;
    }

    currentTeacher = data.teacher;
    assignedStudents = data.students;

    document.getElementById('teacher-display-name').textContent = currentTeacher.name;
    document.getElementById('loading-screen').style.display = 'none';
    document.getElementById('app').style.display = 'flex';
    
    renderStudents();
  } catch (err) {
    document.getElementById('loading-screen').innerHTML = '<h2>Connection Error</h2><p>Could not load database.</p>';
  }
});

function renderStudents() {
  const grid = document.getElementById('student-grid');
  grid.innerHTML = '';

  assignedStudents.forEach(student => {
    const initials = student.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
    const card = document.createElement('div');
    card.className = 'student-card';
    card.id = `card-${student.id}`;
    card.onclick = () => selectStudent(student);

    card.innerHTML = `
      <div class="student-avatar">${initials}</div>
      <div class="student-info">
        <div class="student-name">${student.name}</div>
        <div class="student-sub">ID: ${student.id}</div>
        <div class="student-tags">${student.subject} · ${student.mode}</div>
      </div>
    `;
    grid.appendChild(card);
  });
}

function selectStudent(student) {
  selectedStudent = student;
  selectedStatus = null;
  document.querySelectorAll('.student-card').forEach(c => c.classList.remove('selected'));
  document.getElementById(`card-${student.id}`).classList.add('selected');
  document.querySelectorAll('.att-btn').forEach(b => b.classList.remove('selected'));
  
  document.getElementById('subject-field').value = student.subject;
  document.getElementById('wa-section').classList.remove('show');
  
  // Clear fields
  document.getElementById('covered-note').value = '';
  document.getElementById('homework-note').value = '';
  document.getElementById('stage-note').value = '';
  
  document.getElementById('log-form').style.display = 'block';
  document.getElementById('log-form').scrollIntoView({ behavior: 'smooth' });
}

function selectAttendance(btn) {
  document.querySelectorAll('.att-btn').forEach(b => b.classList.remove('selected'));
  selectedStatus = btn.dataset.status;
  btn.classList.add('selected');
  
  const fields = document.getElementById('fields-section');
  if (selectedStatus === 'LMC' || selectedStatus === 'Rescheduled') {
    fields.style.display = 'none';
  } else {
    fields.style.display = 'block';
  }
}

async function submitLog() {
  if (!selectedStudent || !selectedStatus) {
    showToast('Please select a student and attendance status.');
    return;
  }

  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.textContent = 'Submitting...';

  const now = new Date();
  const dateStr = now.toISOString().split('T')[0];
  const timeStr = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });

  const payload = {
    teacherId: currentTeacher.id,
    studentId: selectedStudent.id,
    classType: document.getElementById('class-type').value,
    subject: selectedStudent.subject,
    date: dateStr,
    time: timeStr,
    status: selectedStatus,
    covered: document.getElementById('covered-note').value.trim(),
    homework: document.getElementById('homework-note').value.trim(),
    stage: document.getElementById('stage-note').value.trim(),
    isMakeup: false
  };

  try {
    const fd = new FormData();
    fd.append('data', JSON.stringify(payload));
    
    const res = await fetch(APPS_SCRIPT_URL, { method: 'POST', body: fd });
    const result = await res.json();

    if (result.success) {
      showToast(`✓ Logged ${selectedStatus} for ${selectedStudent.name}`);
      generateWhatsApp(payload, selectedStudent.name, now);
      
      // Reset form
      document.getElementById('log-form').style.display = 'none';
      document.querySelectorAll('.student-card').forEach(c => c.classList.remove('selected'));
      selectedStudent = null;
      selectedStatus = null;
    } else {
      showToast('Error: ' + result.error);
    }
  } catch (e) {
    showToast('Connection error. Try again.');
  }
  
  btn.disabled = false;
  btn.textContent = 'Log Class ✦';
}

function generateWhatsApp(payload, studentName, dateObj) {
  if (payload.status === 'LMC') {
    waMessage = `Hi,\n${studentName}'s class today was cancelled last minute.\n\nRegards,\n${currentTeacher.name}`;
  } else if (payload.status === 'Rescheduled') {
    waMessage = `Hi,\n${studentName}'s session today has been marked to be rescheduled. We will coordinate a makeup date soon.\n\nRegards,\n${currentTeacher.name}`;
  } else {
    const dateDisplay = dateObj.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
    const formatBullets = (txt) => txt ? txt.split('\n').map(l => '- ' + l).join('\n') : '';
    
    let msg = `Hi,\nHere's an update for ${studentName}'s session on ${dateDisplay} 🎹\n`;
    if (payload.stage) msg += `\n📌 Current Stage: ${payload.stage}\n`;
    if (payload.covered) msg += `\n📖 *What We Covered*\n${formatBullets(payload.covered)}\n`;
    if (payload.homework) msg += `\n🏠 *Practice This Week*\n${formatBullets(payload.homework)}\n`;
    msg += `\nRegards,\n${currentTeacher.name}`;
    waMessage = msg;
  }
  
  document.getElementById('wa-preview').textContent = waMessage;
  document.getElementById('wa-section').classList.add('show');
  document.getElementById('wa-section').scrollIntoView({ behavior: 'smooth' });
}

function copyMessage() {
  navigator.clipboard.writeText(waMessage).then(() => showToast('Copied to clipboard!'));
}

function openWhatsApp() {
  window.open(`https://wa.me/?text=${encodeURIComponent(waMessage)}`, '_blank');
}

function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}
</script>
