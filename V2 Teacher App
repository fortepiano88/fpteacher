        <div class="field-group">
          <label class="field-label">Subject</label>
          <input type="text" id="subject-field" readonly style="background:var(--gray-light); color:var(--gray-dark);">
        </div>
        <div class="field-group">
          <label class="field-label">Stage</label>
          <input type="text" id="stage-note" placeholder="e.g. Beginner 1">
        </div>
        <div class="field-group">
          <label class="field-label">What was covered today</label>
          <textarea id="covered-note" rows="3"></textarea>
        </div>
        <div class="field-group">
          <label class="field-label">Homework / Practice</label>
          <textarea id="homework-note" rows="3"></textarea>
        </div>
      </div>

      <button class="submit-btn" id="submit-btn" onclick="submitLog()">Log Class ✦</button>
    </div>

    <!-- WhatsApp Section -->
    <div class="wa-section" id="wa-section">
      <div class="wa-title">💬 Parent Update Ready</div>
      <div class="wa-preview" id="wa-preview"></div>
      <div class="wa-actions">
        <button class="copy-btn" onclick="copyMessage()">Copy Message</button>
        <button class="wa-btn" onclick="openWhatsApp()">Send WhatsApp</button>
