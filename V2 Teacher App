<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Fortepiano — Teacher Portal</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --black: #000000;
    --white: #ffffff;
    --gray-light: #f9f9f9;
    --gray-mid: #e0e0e0;
    --gray-dark: #555555;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body {
    font-family: 'Inter', sans-serif; background: var(--white);
    color: var(--black); min-height: 100vh; display: flex; flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  .header {
    border-bottom: 2px solid var(--black); padding: 24px 20px 20px;
    position: sticky; top: 0; z-index: 100; background: var(--white);
    display: flex; align-items: flex-end; justify-content: space-between;
  }
  .header-brand { font-family: 'DM Serif Display', serif; font-size: 26px; font-style: italic; letter-spacing: -0.02em; }
  .header-teacher { font-size: 12px; color: var(--gray-dark); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
  .header-teacher span { color: var(--black); font-weight: 600; }

  .main { flex: 1; padding: 30px 20px 60px; max-width: 500px; margin: 0 auto; width: 100%; }

  .section-title { font-family: 'DM Serif Display', serif; font-size: 20px; margin-bottom: 16px; border-bottom: 1px solid var(--gray-mid); padding-bottom: 8px; }

  .student-grid { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
  .student-card {
    background: var(--white); border: 1px solid var(--black); border-radius: 0;
    padding: 16px; cursor: pointer; transition: all 0.2s ease; position: relative;
  }
  .student-card:hover { background: var(--gray-light); }
  .student-card.selected { background: var(--black); color: var(--white); }
  .student-card.selected .student-name { color: var(--white); }
  .student-card.selected .tag { border-color: var(--white); color: var(--white); }
  .student-card.selected .metrics { color: #d0d0d0; }
  
  .student-name { font-family: 'DM Serif Display', serif; font-size: 20px; color: var(--black); margin-bottom: 8px; }
  
  .tag-row { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
  .tag { font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid var(--black); padding: 4px 8px; font-weight: 500; }
  
  .metrics { font-size: 12px; color: var(--gray-dark); display: flex; justify-content: space-between; border-top: 1px dashed var(--gray-mid); padding-top: 12px; }
  .metric-alert { font-weight: 600; color: #d32f2f; } /* Subtle red if classes are 0 */

  #log-form { display: none; animation: fadeIn 0.4s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .attendance-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 30px; }
  .att-btn {
    border: 1px solid var(--black); border-radius: 0; padding: 14px 8px;
    cursor: pointer; text-align: center; background: var(--white);
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500; color: var(--black); transition: all 0.2s;
  }
  .att-btn.selected { background: var(--black); color: var(--white); }

  .field-group { margin-bottom: 24px; }
  .field-label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--black); margin-bottom: 10px; display: block; }
  
  textarea, select {
    width: 100%; border: 1px solid var(--black); border-radius: 0; padding: 14px;
    font-family: 'Inter', sans-serif; font-size: 14px; color: var(--black); background: var(--white); outline: none; line-height: 1.6;
    appearance: none;
  }
  textarea:focus, select:focus { box-shadow: 4px 4px 0px var(--black); }

  .submit-btn {
    width: 100%; background: var(--black); color: var(--white); border: 2px solid var(--black); border-radius: 0; padding: 18px;
    font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600; letter-spacing: 0.05em; cursor: pointer; transition: all 0.2s;
  }
  .submit-btn:disabled { background: var(--white); color: var(--gray-mid); border-color: var(--gray-mid); cursor: not-allowed; }
  .submit-btn:hover:not(:disabled) { background: var(--white); color: var(--black); }

  .wa-section { display: none; background: var(--gray-light); border: 1px solid var(--black); padding: 24px; margin-top: 30px; }
  .wa-section.show { display: block; }
  .wa-title { font-family: 'DM Serif Display', serif; font-size: 18px; margin-bottom: 12px; }
  .wa-preview { background: var(--white); border: 1px solid var(--gray-mid); padding: 16px; font-size: 13px; line-height: 1.6; white-space: pre-wrap; margin-bottom: 16px; }
  .wa-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .wa-btn { background: var(--black); color: var(--white); border: 1px solid var(--black); padding: 14px; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; font-size: 13px; }
  .wa-btn.secondary { background: var(--white); color: var(--black); }

  #loading-screen { position: fixed; inset: 0; background: var(--white); display: flex; align-items: center; justify-content: center; flex-direction: column; z-index: 999; }
  
  .toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px); background: var(--black); color: var(--white); padding: 14px 24px; font-size: 14px; font-weight: 500; transition: transform 0.3s ease; z-index: 999; border: 1px solid var(--white); }
  .toast.show { transform: translateX(-50%) translateY(0); }
</style>
</head>
<body>

<div id="loading-screen">
  <div style="font-family:'DM Serif Display',serif; font-size:36px; font-style:italic;">Fortepiano</div>
  <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.1em; color:var(--gray-dark); margin-top:16px;">Connecting Database...</div>
</div>

<div id="app" style="display:none; flex-direction:column; min-height:100vh;">
  <div class="header">
    <div class="header-brand">Fortepiano</div>
    <div class="header-teacher">Tutor <br><span id="teacher-display-name">—</span></div>
  </div>

  <div class="main">
    <div class="section-title">Select Student</div>
    <div class="student-grid" id="student-grid"></div>

    <div id="log-form">
      <div class="section-title">Log Session</div>
      <div class="attendance-row">
        <button class="att-btn" data-status="Attended" onclick="selectAttendance(this)">Attended</button>
        <button class="att-btn" data-status="LMC" onclick="selectAttendance(this)">Late Cancel</button>
        <button class="att-btn" data-status="Rescheduled" onclick="selectAttendance(this)">Reschedule</button>
      </div>

      <div id="fields-section">
        <div class="field-group">
          <label class="field-label">Class Type</label>
          <select id="class-type">
            <option value="Regular">Regular Term</option>
            <option value="Summer">Summer Session</option>
          </select>
        </div>
        <div class="field-group">
          <label class="field-label">Current Stage</label>
          <select id="stage-note">
            <option value="" disabled selected>Select Level...</option>
            <option value="Foundation">Foundation</option>
            <option value="Initial">Initial Grade</option>
            <option value="Grade 1">Grade 1</option>
            <option value="Grade 2">Grade 2</option>
            <option value="Grade 3">Grade 3</option>
            <option value="Grade 4">Grade 4</option>
            <option value="Grade 5">Grade 5</option>
            <option value="Grade 6">Grade 6</option>
            <option value="Grade 7">Grade 7</option>
            <option value="Grade 8">Grade 8</option>
            <option value="Diploma">Diploma</option>
          </select>
        </div>
        <div class="field-group">
          <label class="field-label">Material Covered</label>
          <textarea id="covered-note" rows="3" placeholder="Repertoire, technique, scales..."></textarea>
        </div>
        <div class="field-group">
          <label class="field-label">Practice Notes</label>
          <textarea id="homework-note" rows="3" placeholder="What should they focus on this week?"></textarea>
        </div>
      </div>

      <button class="submit-btn" id="submit-btn" onclick="submitLog()">Log Class</button>
    </div>

    <!-- WhatsApp Section -->
    <div class="wa-section" id="wa-section">
      <div class="wa-title">Parent Update Generated</div>
      <div class="wa-preview" id="wa-preview"></div>
      <div class="wa-actions">
        <button class="wa-btn secondary" onclick="copyMessage()">Copy Text</button>
        <button class="wa-btn" onclick="openWhatsApp()">Send WhatsApp</button>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// --- IMPORTANT: Paste your Web App URL below ---
const APPS_SCRIPT_URL = 'YOUR_WEB_APP_URL_HERE';

let currentTeacher = null;
let assignedStudents = [];
let selectedStudent = null;
let selectedStatus = null;
let waMessage = '';

window.addEventListener('DOMContentLoaded', async () => {
  const params = new URLSearchParams(window.location.search);
  const accessKey = params.get('key');

  if (!accessKey) {
    document.getElementById('loading-screen').innerHTML = '<div style="font-family:serif; font-size:24px;">Access Denied</div>';
    return;
  }

  try {
    const res = await fetch(`${APPS_SCRIPT_URL}?key=${encodeURIComponent(accessKey)}`);
    const data = await res.json();

    if (!data.success) {
      document.getElementById('loading-screen').innerHTML = `<div style="font-family:serif; font-size:20px;">${data.error}</div>`;
      return;
    }

    currentTeacher = data.teacher;
    assignedStudents = data.students;

    document.getElementById('teacher-display-name').textContent = currentTeacher.name;
    document.getElementById('loading-screen').style.display = 'none';
    document.getElementById('app').style.display = 'flex';
    
    renderStudents();
  } catch (err) {
    document.getElementById('loading-screen').innerHTML = 'Database Connection Error.';
  }
});

function renderStudents() {
  const grid = document.getElementById('student-grid');
  grid.innerHTML = '';

  assignedStudents.forEach(student => {
    const card = document.createElement('div');
    card.className = 'student-card';
    card.id = `card-${student.id}`;
    card.onclick = () => selectStudent(student);

    const remainingClass = student.remaining <= 1 ? 'metric-alert' : '';

    card.innerHTML = `
      <div class="student-name">${student.name}</div>
      <div class="tag-row">
        <span class="tag">${student.subject}</span>
        <span class="tag">${student.mode}</span>
      </div>
      <div class="metrics">
        <span class="${remainingClass}">${student.remaining} Classes Left</span>
        <span>${student.makeups} Pending Makeups</span>
      </div>
    `;
    grid.appendChild(card);
  });
}

function selectStudent(student) {
  selectedStudent = student;
  selectedStatus = null;
  document.querySelectorAll('.student-card').forEach(c => c.classList.remove('selected'));
  document.getElementById(`card-${student.id}`).classList.add('selected');
  document.querySelectorAll('.att-btn').forEach(b => b.classList.remove('selected'));
  
  document.getElementById('wa-section').classList.remove('show');
  document.getElementById('covered-note').value = '';
  document.getElementById('homework-note').value = '';
  document.getElementById('stage-note').value = '';
  
  document.getElementById('log-form').style.display = 'block';
  document.getElementById('log-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function selectAttendance(btn) {
  document.querySelectorAll('.att-btn').forEach(b => b.classList.remove('selected'));
  selectedStatus = btn.dataset.status;
  btn.classList.add('selected');
  
  const fields = document.getElementById('fields-section');
  if (selectedStatus === 'LMC' || selectedStatus === 'Rescheduled') {
    fields.style.display = 'none';
  } else {
    fields.style.display = 'block';
  }
}

async function submitLog() {
  if (!selectedStudent || !selectedStatus) {
    showToast('Select a student and attendance status.');
    return;
  }

  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.textContent = 'Submitting...';

  const now = new Date();
  const dateStr = now.toISOString().split('T')[0];
  const timeStr = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });

  const payload = {
    teacherId: currentTeacher.id,
    studentId: selectedStudent.id,
    classType: document.getElementById('class-type').value,
    subject: selectedStudent.subject, // Hidden from UI, pulled directly from data
    date: dateStr,
    time: timeStr,
    status: selectedStatus,
    covered: document.getElementById('covered-note').value.trim(),
    homework: document.getElementById('homework-note').value.trim(),
    stage: document.getElementById('stage-note').value,
    isMakeup: false
  };

  try {
    const fd = new FormData();
    fd.append('data', JSON.stringify(payload));
    
    const res = await fetch(APPS_SCRIPT_URL, { method: 'POST', body: fd });
    const result = await res.json();

    if (result.success) {
      showToast(`Class logged for ${selectedStudent.name}`);
      
      // Update local metrics temporarily so UI feels fast
      if (selectedStatus === 'Attended' || selectedStatus === 'LMC') selectedStudent.remaining--;
      if (selectedStatus === 'Rescheduled') selectedStudent.makeups++;
      renderStudents();
      document.getElementById(`card-${selectedStudent.id}`).classList.add('selected');

      generateWhatsApp(payload, selectedStudent.name, now);
      
      document.getElementById('log-form').style.display = 'none';
      selectedStatus = null;
    } else {
      showToast('Error: ' + result.error);
    }
  } catch (e) {
    showToast('Connection error. Try again.');
  }
  
  btn.disabled = false;
  btn.textContent = 'Log Class';
}

function generateWhatsApp(payload, studentName, dateObj) {
  if (payload.status === 'LMC') {
    waMessage = `Hi,\n${studentName}'s class today was cancelled last minute.\n\nRegards,\n${currentTeacher.name}`;
  } else if (payload.status === 'Rescheduled') {
    waMessage = `Hi,\n${studentName}'s session today has been marked to be rescheduled. We will coordinate a makeup date soon.\n\nRegards,\n${currentTeacher.name}`;
  } else {
    const dateDisplay = dateObj.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
    const formatBullets = (txt) => txt ? txt.split('\n').map(l => '- ' + l).join('\n') : '';
    
    let msg = `Hi,\nHere is an update for ${studentName}'s session on ${dateDisplay}.\n`;
    if (payload.stage) msg += `\nLevel: ${payload.stage}\n`;
    if (payload.covered) msg += `\nCovered Today:\n${formatBullets(payload.covered)}\n`;
    if (payload.homework) msg += `\nPractice Notes:\n${formatBullets(payload.homework)}\n`;
    msg += `\nRegards,\n${currentTeacher.name}`;
    waMessage = msg;
  }
  
  document.getElementById('wa-preview').textContent = waMessage;
  document.getElementById('wa-section').classList.add('show');
  document.getElementById('wa-section').scrollIntoView({ behavior: 'smooth', block: 'end' });
}

function copyMessage() {
  navigator.clipboard.writeText(waMessage).then(() => showToast('Copied to clipboard!'));
}

function openWhatsApp() {
  window.open(`https://wa.me/?text=${encodeURIComponent(waMessage)}`, '_blank');
}

function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}
</script>
</body>
</html>
