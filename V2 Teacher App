<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Fortepiano — Teacher App</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #000000;
    --paper: #ffffff;
    --gray-light: #f5f5f5;
    --gray-mid: #e0e0e0;
    --gray-dark: #666666;
    --shadow: 0 4px 20px rgba(0,0,0,0.06);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body {
    font-family: 'DM Sans', sans-serif; background: var(--gray-light);
    color: var(--ink); min-height: 100vh; display: flex; flex-direction: column;
  }

  .header {
    background: var(--ink); color: var(--paper); padding: 18px 20px 16px;
    position: sticky; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between;
  }
  .header-brand { font-family: 'DM Serif Display', serif; font-size: 22px; }
  .header-teacher { font-size: 13px; color: var(--gray-mid); font-weight: 400; }
  .header-teacher span { color: var(--paper); font-weight: 500; }

  .main { flex: 1; padding: 20px 16px 40px; max-width: 480px; margin: 0 auto; width: 100%; }

  .section-label { font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray-dark); margin-bottom: 10px; }

  .student-grid { display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
  .student-card {
    background: var(--paper); border: 1px solid var(--gray-mid); border-radius: 8px;
    padding: 14px 16px; cursor: pointer; transition: all 0.18s ease; display: flex; align-items: center; gap: 14px;
  }
  .student-card:hover { border-color: var(--ink); }
  .student-card.selected { border-color: var(--ink); border-width: 2px; padding: 13px 15px; }
  
  .student-avatar {
    width: 40px; height: 40px; border-radius: 4px; background: var(--ink); display: flex; align-items: center; justify-content: center;
    font-family: 'DM Serif Display', serif; font-size: 16px; color: var(--paper); flex-shrink: 0;
  }
  .student-info { flex: 1; min-width: 0; }
  .student-name { font-weight: 600; font-size: 15px; color: var(--ink); }
  .student-sub { font-size: 11px; color: var(--gray-dark); margin-top: 2px; font-family: monospace; }
  .student-tags { font-size: 10px; display: inline-block; padding: 2px 6px; background: var(--gray-light); border-radius: 4px; margin-top: 4px; }

  .attendance-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 24px; }
  .att-btn {
    border: 1px solid var(--gray-mid); border-radius: 8px; padding: 12px 8px;
    cursor: pointer; text-align: center; background: var(--paper);
    transition: all 0.18s ease; font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 600; color: var(--gray-dark);
  }
  .att-btn.selected { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .field-group { margin-bottom: 20px; }
  .field-label { font-size: 11px; font-weight: 600; letter-spacing: 0.10em; text-transform: uppercase; color: var(--gray-dark); margin-bottom: 8px; display: block; }
  textarea, input, select {
    width: 100%; border: 1px solid var(--gray-mid); border-radius: 8px; padding: 12px 14px;
    font-family: 'DM Sans', sans-serif; font-size: 14px; color: var(--ink); background: var(--paper); outline: none; line-height: 1.5;
  }
  textarea:focus, input:focus, select:focus { border-color: var(--ink); }

  .submit-btn {
    width: 100%; background: var(--ink); color: var(--paper); border: none; border-radius: 8px; padding: 16px;
    font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.2s;
  }
  .submit-btn:disabled { background: var(--gray-mid); cursor: not-allowed; }

  .wa-section {
    display: none; background: var(--paper); border: 2px solid #25D366; border-radius: 8px; padding: 20px; margin-top: 20px;
  }
  .wa-section.show { display: block; }
  .wa-title { font-size: 13px; font-weight: 600; color: #1a8a3a; margin-bottom: 10px; }
  .wa-preview { background: #f0fdf4; border-radius: 8px; padding: 12px; font-size: 13px; line-height: 1.6; white-space: pre-wrap; margin-bottom: 14px; border: 1px solid #c3e6cb; }
  .wa-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .wa-btn { width: 100%; background: #25D366; color: white; border: none; border-radius: 8px; padding: 14px; font-weight: 600; cursor: pointer; }
  .copy-btn { width: 100%; background: var(--paper); color: var(--ink); border: 1px solid var(--ink); border-radius: 8px; padding: 14px; font-weight: 600; cursor: pointer; }

  #loading-screen { position: fixed; inset: 0; background: var(--paper); display: flex; align-items: center; justify-content: center; flex-direction: column; z-index: 999; }
  .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(80px); background: var(--ink); color: var(--paper); padding: 12px 24px; border-radius: 4px; font-size: 14px; font-weight: 500; transition: transform 0.3s ease; z-index: 999; }
  .toast.show { transform: translateX(-50%) translateY(0); }
</style>
</head>
<body>

<div id="loading-screen">
  <div style="font-family:'DM Serif Display',serif; font-size:32px;">Fortepiano</div>
  <div style="font-size:14px; color:var(--gray-dark); margin-top:10px;">Authenticating...</div>
</div>

<div id="app" style="display:none; flex-direction:column; min-height:100vh;">
  <div class="header">
    <div class="header-brand">Fortepiano</div>
    <div class="header-teacher">Instructor <span id="teacher-display-name">—</span></div>
  </div>

  <div class="main">
    <div class="section-label">Select Student</div>
    <div class="student-grid" id="student-grid"></div>

    <div id="log-form" style="display:none;">
      <div class="section-label">Attendance</div>
      <div class="attendance-row">
        <button class="att-btn" data-status="Attended" onclick="selectAttendance(this)">Attended</button>
        <button class="att-btn" data-status="LMC" onclick="selectAttendance(this)">Late Cancel</button>
        <button class="att-btn" data-status="Rescheduled" onclick="selectAttendance(this)">Reschedule</button>
      </div>

      <div id="fields-section">
        <div class="field-group">
          <label class="field-label">Class Type</label>
          <select id="class-type">
            <option value="Regular">Regular</option>
            <option value="Summer">Summer</option>
          </select>
